PORT=3000
QUICKGLIMPSE_BASE_URL=https://qglimpse.example.com
# NODE_ENV is set to production by `npm start` and `ecosystem.config.cjs`.
# NODE_ENV=production
# Set to 1 when running behind one trusted reverse proxy that sets X-Forwarded-For.
QUICKGLIMPSE_TRUST_PROXY=false
# Relative paths are resolved from the repository root, not the npm workspace directory.
QUICKGLIMPSE_DATA_DIR=/var/lib/quickglimpse
QUICKGLIMPSE_DB_PATH=/var/lib/quickglimpse/quickglimpse.db

# Generate a 32-byte database encryption key:
# PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Bash: openssl rand -base64 32
QUICKGLIMPSE_DB_ENCRYPTION_KEY=change-me-db-key
QUICKGLIMPSE_SESSION_SECRET=change-me-session-secret
QUICKGLIMPSE_SESSION_TTL_MS=2592000000
QUICKGLIMPSE_SESSION_IDLE_TTL_MS=2592000000

# Cloudflare Turnstile is required for deployed environments.
# Create a Turnstile widget at https://dash.cloudflare.com/ and set both values.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SEND_ADDRESS=
SMTP_SERVER_ADDRESS=
SMTP_PORT=587
SMTP_SECURE_LOGIN_TYPE=starttls
